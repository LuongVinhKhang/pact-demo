{
  "consumer": {
    "name": "OrdersService"
  },
  "interactions": [
    {
      "description": "a request for all products",
      "providerStates": [
        {
          "name": "products exist"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer internal-service-key-2024"
        },
        "method": "GET",
        "path": "/products"
      },
      "response": {
        "body": [
          {
            "id": "1",
            "inStock": true,
            "name": "Laptop",
            "price": 999.99
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for product 1",
      "providerStates": [
        {
          "name": "product with ID 1 exists"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer internal-service-key-2024"
        },
        "method": "GET",
        "path": "/products/1"
      },
      "response": {
        "body": {
          "id": "1",
          "inStock": true,
          "name": "Laptop",
          "price": 999.99
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.3.0"
    },
    "pactRust": {
      "ffi": "0.5.3",
      "models": "1.3.9"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "ProductsService"
  }
}