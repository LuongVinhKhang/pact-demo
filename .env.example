# .env.example

# --- Self-hosted local Pact Broker (docker compose up -d) ---
# Self-hosted broker uses Basic auth (username:password), not Bearer token
PACT_BROKER_URL=http://localhost:9292
PACT_BROKER_USERNAME=pact
PACT_BROKER_PASSWORD=pact
GIT_BRANCH=main
GIT_COMMIT=abc123

# --- PactFlow (free tier) ---
# PactFlow uses Bearer token auth
# PACT_BROKER_URL=https://your-org.pactflow.io
# PACT_BROKER_TOKEN=<your-pactflow-api-token>
# GIT_BRANCH=main
# GIT_COMMIT=abc123
